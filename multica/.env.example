# Values to set in ~/apps/multica/.env AFTER `make selfhost` has created it
# (make selfhost already generates JWT_SECRET and POSTGRES_PASSWORD; keep those).
# NEVER commit the real .env.

# Load the hardening override on top of the official self-host compose file
COMPOSE_FILE=docker-compose.selfhost.yml:docker-compose.local.yml

# Ports (avoid clashing with other local apps on 3000/8080)
PORT=8180
FRONTEND_PORT=3200
FRONTEND_ORIGIN=http://localhost:3200
MULTICA_APP_URL=http://localhost:3200

APP_ENV=production
ALLOW_SIGNUP=true          # set false after creating your account
DO_NOT_TRACK=1             # disable anonymous daily telemetry
ANALYTICS_DISABLED=true

POSTGRES_DB=multica
POSTGRES_USER=multica
# POSTGRES_PASSWORD=<generated>
# JWT_SECRET=<generated>
# RESEND_API_KEY=          # optional: email login codes
