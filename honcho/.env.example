# Copy to ~/apps/honcho/.env and fill in the values. NEVER commit the real .env.
# Start from Honcho's own .env.template and make sure these are set:

# LLM provider used by the deriver for reasoning (required, or the server will not start)
LLM_OPENAI_API_KEY=sk-...

# Optional: use OpenRouter / another model instead of OpenAI defaults
# DERIVER_MODEL_CONFIG__TRANSPORT=openai
# DERIVER_MODEL_CONFIG__MODEL=google/gemini-2.5-flash
# DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# Database password (used by docker-compose.yml)
POSTGRES_PASSWORD=change-me-long-random

# Auth: false = simplest for a single laptop (ports are localhost-only anyway)
AUTH_USE_AUTH=false
# If AUTH_USE_AUTH=true, set a secret and generate a JWT for Claude:
# AUTH_JWT_SECRET=<output of: python scripts/generate_jwt_secret.py>

VECTOR_STORE_TYPE=pgvector
LOG_LEVEL=INFO
